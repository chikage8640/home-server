CONTAINER_UID=1000
CONTAINER_GID=1000
IDP_DOMAIN=
KEYCLOAK_REALM=
TZ=Asia/Tokyo
SSD_PATH=./data/ssd
HDD_PATH=./data/hdd

OC_DOMAIN=
OC_DEFAULT_LANGUAGE=ja
OC_OIDC_CLIENT_ID=
OC_OIDC_CLIENT_SCOPES=openid profile email roles
STORAGE_USERS_DECOMPOSEDS3_BUCKET=opencloud
STORAGE_USERS_DECOMPOSEDS3_ACCESS_KEY=
STORAGE_USERS_DECOMPOSEDS3_SECRET_KEY=

# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables
# The Immich version to use. You can pin this to a specific version like "v2.1.0"
# IMMICH_VERSION=v2
# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
IM_DB_DATABASE_NAME=immich
IM_DB_USERNAME=postgres
IM_DB_PASSWORD=postgres
IM_DOMAIN=

TRAEFIK_CERT_DOMAIN=
TRAEFIK_PORT_HTTPS=443
ACME_EMAIL=
CF_DNS_API_TOKEN=